# Copy to yt-sync.env (same folder), fill in, then: chmod 600 yt-sync.env
# yt-sync.env holds your Navidrome password - it is git-ignored; never commit it.

# Your J-Pop playlist (a public or unlisted playlist works without cookies)
PLAYLIST_URL="https://www.youtube.com/playlist?list=PUT_YOUR_PLAYLIST_ID_HERE"

# Where the library lives (must match Navidrome's MusicFolder)
MUSIC_DIR="/storage/43CC-5E0C/Music"
# Every playlist track is written FLAT into MUSIC_DIR/<PLAYLIST_SUBDIR>/ (no per-artist folders).
# The default playlist file is MUSIC_DIR/<PLAYLIST_SUBDIR>.m3u; override with M3U_FILE below.
PLAYLIST_SUBDIR="ytsync"                    # e.g. "J-Pop"
# Only set this if Navidrome sees the same folder under a different path (e.g. inside Linux Deploy chroot).
# The m3u is written with THIS prefix so Navidrome can match tracks.
#NAVIDROME_MUSIC_DIR="/music"

# Navidrome (a normal user is enough to start a scan)
NAVIDROME_URL="http://127.0.0.1:4533"
ND_USER="your-navidrome-user"
ND_PASS="your-navidrome-password"

# Optional
#M3U_FILE="$MUSIC_DIR/J-Pop.m3u"                     # overrides the PLAYLIST_SUBDIR default
#YTDLP_COOKIES="$HOME/.config/yt-sync/cookies.txt"   # for private playlists / age-gated videos
#YTDLP_EXTRA_ARGS="--limit-rate 2M"
#NEWEST_AT_START=1                                    # set if your playlist adds new videos at the TOP (index 1 = newest)
#FORCE_RESCAN=1                                      # rescan even when nothing new was added
#STATE_DIR="$HOME/.local/share/yt-sync"               # archive, db, staging, log
